generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String            @id @default(uuid()) @db.Uuid
  clerkId     String            @unique
  name        String?
  email       String            @unique
  role        String            @default("VIEWER")
  memberships WorkspaceMember[]
  expenses    Expense[]         @relation("ExpenseApprover")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Workspace {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  slug          String            @unique
  members       WorkspaceMember[]
  clientVendors ClientVendor[]
  budgets      Budget[]
  cashflows    CashflowTransaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model ClientVendor {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  name        String
  type        String
  email       String?
  phone       String?
  picName     String?
  address     String?
  npwp        String?
  isActive    Boolean      @default(true)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposals   Proposal[]
  invoices    Invoice[]
  expenses    Expense[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, isActive])
}

model Proposal {
  id             String         @id @default(uuid()) @db.Uuid
  clientId       String         @db.Uuid
  proposalNumber String         @unique
  status         String
  totalAmount    Decimal        @db.Decimal(18,2)
  validUntil     DateTime       @db.Date
  client         ClientVendor   @relation(fields: [clientId], references: [id])
  items          ProposalItem[]
  invoice        Invoice?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProposalItem {
  id          String   @id @default(uuid()) @db.Uuid
  proposalId  String   @db.Uuid
  description String
  qty         Int
  unitPrice   Decimal  @db.Decimal(18,2)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String         @id @default(uuid()) @db.Uuid
  clientId      String         @db.Uuid
  proposalId    String?        @unique @db.Uuid
  invoiceNumber String         @unique
  status        String
  dueDate       DateTime       @db.Date
  totalAmount   Decimal        @db.Decimal(18,2)
  client        ClientVendor   @relation(fields: [clientId], references: [id])
  proposal      Proposal?      @relation(fields: [proposalId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String
  qty         Int
  unitPrice   Decimal  @db.Decimal(18,2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String                @id @default(uuid()) @db.Uuid
  invoiceId   String                @db.Uuid
  amount      Decimal               @db.Decimal(18,2)
  paymentDate DateTime              @db.Date
  method      String
  invoice     Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cashflow    CashflowTransaction[]
  createdAt   DateTime              @default(now())
}

model Expense {
  id          String                @id @default(uuid()) @db.Uuid
  vendorId    String                @db.Uuid
  approvedBy  String?               @db.Uuid
  category    String
  amount      Decimal               @db.Decimal(18,2)
  expenseDate DateTime              @db.Date
  status      String
  vendor      ClientVendor          @relation(fields: [vendorId], references: [id])
  approver    User?                 @relation("ExpenseApprover", fields: [approvedBy], references: [id])
  cashflow    CashflowTransaction[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CashflowTransaction {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String?   @db.Uuid
  type            String
  category        String
  amount          Decimal   @db.Decimal(18,2)
  transactionDate DateTime  @db.Date
  sourceRef       String?
  paymentId       String?   @db.Uuid
  expenseId       String?   @db.Uuid
  payment         Payment?  @relation(fields: [paymentId], references: [id])
  expense         Expense?  @relation(fields: [expenseId], references: [id])
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  @@index([workspaceId, transactionDate])
}

model Budget {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String?  @db.Uuid
  category      String
  period        String
  plannedAmount Decimal  @db.Decimal(18,2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, period])
}
