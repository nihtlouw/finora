:root{--f-bg:#e1e8e5;--f-panel:#f3f7f5;--f-panel-2:#eef4f1;--f-ink:#14232a;--f-muted:#66747b;--f-line:#d3dfdb;--f-teal:#0b6a60;--f-teal-2:#064a45;--f-green:#16a36d;--f-blue:#2e7dd7;--f-amber:#d89b35;--f-red:#c75b4b;--f-shadow:0 10px 32px rgba(16,55,47,.06);--f-shadow-hover:0 18px 46px rgba(16,55,47,.12);--f-side-w:clamp(208px,18vw,240px)}
*{box-sizing:border-box}html{background:var(--f-bg);scroll-behavior:smooth}body{margin:0;background:linear-gradient(180deg,rgba(6,74,69,.20) 0%,rgba(6,74,69,.18) 22%,rgba(6,74,69,.13) 42%,rgba(6,74,69,.08) 60%,rgba(225,232,229,.04) 78%,rgba(225,232,229,0) 100%),var(--f-bg);background-attachment:fixed;color:var(--f-ink);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}a{text-decoration:none;color:inherit}button,input,select,textarea{font:inherit}.f-app{display:flex;min-height:100dvh;align-items:stretch}.f-side{width:var(--f-side-w);min-width:var(--f-side-w);background:linear-gradient(180deg,#063f3c,#07534c);color:#eaf8f5;padding:18px 12px;position:sticky;top:0;height:100dvh;display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-width:thin}.f-side::-webkit-scrollbar{width:6px}.f-side::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:99px}.f-brand{display:flex;gap:10px;align-items:center;padding:8px 10px 22px;flex:0 0 auto}.f-brand-mark{display:grid;place-items:center;width:34px;height:34px;background:#e7fff9;color:#0b5c52;border-radius:10px;font-weight:900}.f-brand b{display:block;font-size:24px;letter-spacing:-.03em}.f-brand small{display:block;opacity:.7;font-size:9px;text-transform:uppercase;letter-spacing:.12em}.f-workspace{display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);padding:10px;border-radius:12px;margin-bottom:16px}.f-workspace>div{min-width:0;flex:1}.f-workspace small,.f-user small{display:block;opacity:.65;font-size:10px}.f-workspace strong{font-size:12px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.f-work-avatar{width:30px;height:30px;border-radius:9px;background:#2d9d89;display:grid;place-items:center;font-size:10px;font-weight:800;flex:0 0 auto}.f-nav{display:flex;flex-direction:column;gap:4px}.f-nav-item{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:10px;color:rgba(237,250,247,.78);font-weight:600;font-size:12px;white-space:nowrap;min-width:0}.f-nav-item:hover{background:rgba(255,255,255,.07);color:white}.f-nav-item.active{background:#eff7f4;color:#0b5a4f;box-shadow:0 8px 24px rgba(0,0,0,.14)}.f-nav-item>span{width:17px;min-width:17px;text-align:center}.f-nav-item em{margin-left:auto;background:#ffb36b;color:#4e2e0c;font-style:normal;padding:2px 6px;border-radius:99px;font-size:9px}.f-side-bottom{margin-top:auto;padding-top:14px}.f-help-card{padding:14px;border-radius:14px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);margin-bottom:12px}.f-help-card strong{display:block;font-size:13px}.f-help-card p{margin:7px 0 0;font-size:10px;opacity:.65}.f-user{display:flex;gap:8px;align-items:center;padding:8px 4px}.f-user>div:last-child{min-width:0}.f-user strong{display:block;font-size:11px}.f-main{flex:1;min-width:0;position:relative}.f-main:before{content:"";position:absolute;inset:0 0 auto;top:0;height:280px;pointer-events:none;background:linear-gradient(180deg,rgba(6,74,69,.045),rgba(6,74,69,0));z-index:0}.f-content{position:relative;z-index:1}.f-top{height:68px;background:linear-gradient(180deg,rgba(6,74,69,.20) 0%,rgba(225,235,232,.48) 78%,rgba(243,247,245,.26) 100%);border-bottom:1px solid rgba(255,255,255,.36);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(16px,2vw,28px);position:sticky;top:0;z-index:20;backdrop-filter:blur(14px) saturate(115%);box-shadow:0 8px 26px rgba(16,55,47,.06)}.f-search-wrap{position:relative;min-width:0;width:min(520px,48vw);flex:0 1 520px}.f-top-search{display:flex;align-items:center;gap:8px;border:1px solid rgba(180,202,196,.82);background:rgba(247,250,248,.76);border-radius:10px;height:40px;padding:0 12px;color:#738087;min-width:0;width:100%}.f-top-search span{font-size:12px}.f-top-search input{border:0;background:transparent;outline:none;flex:1;min-width:0;color:var(--f-ink)}.f-top-search kbd{border:1px solid var(--f-line);border-radius:6px;padding:2px 6px;font-size:10px;background:rgba(235,242,239,.90);white-space:nowrap}.f-top-right{display:flex;align-items:center;gap:8px;min-width:0}.f-icon{width:34px;height:34px;border:1px solid rgba(180,202,196,.82);border-radius:9px;background:rgba(247,250,248,.76);position:relative;display:inline-grid;place-items:center;flex:0 0 auto}.f-icon.dot:after{content:'';position:absolute;width:6px;height:6px;background:#ff5a5f;border-radius:50%;top:5px;right:5px}.f-date{font-size:11px;color:#556b67;padding-left:12px;border-left:1px solid rgba(166,190,183,.72);white-space:nowrap}.f-title{font-size:11px;font-weight:700;color:#2b353a;white-space:nowrap}.f-content{padding:clamp(18px,2vw,28px);max-width:1500px;margin:auto;animation:f-page-in .42s ease both}.f-pagehead{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:20px}.f-pagehead-main{min-width:0}.f-page-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.f-eyebrow{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:#72817e;font-weight:800}.f-pagehead h1{font-size:clamp(28px,3vw,34px);line-height:1.08;letter-spacing:-.04em;margin:2px 0}.f-pagehead p{margin:6px 0 0;color:var(--f-muted);max-width:800px}.f-page-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.f-actions{display:flex;gap:8px;flex-wrap:wrap}.f-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--f-line);background:#f7faf9;border-radius:10px;padding:10px 14px;font-weight:700;font-size:12px;transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease;white-space:nowrap}.f-btn.primary{background:var(--f-teal);color:white;border-color:var(--f-teal)}.f-btn.primary:hover{background:var(--f-teal-2)}.f-btn.soft{background:#ecf8f4;color:#0b6658}.f-btn:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 8px 18px rgba(16,55,47,.09)}.f-btn:active:not(:disabled){transform:translateY(0);box-shadow:none}.f-btn:disabled{opacity:.58;cursor:not-allowed}.f-grid-4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.f-grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.f-stat{position:relative;overflow:hidden;background:linear-gradient(145deg,#f7faf9 0%,#f4f8f7 68%,#eaf4f1 100%);border:1px solid var(--f-line);border-radius:16px;padding:16px;display:flex;gap:12px;box-shadow:var(--f-shadow);transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.f-stat:before{content:"";position:absolute;left:0;top:0;width:4px;height:100%;background:linear-gradient(180deg,var(--f-teal),#56bfa6);opacity:.75}.f-stat:hover{transform:translateY(-3px);box-shadow:var(--f-shadow-hover);border-color:#c7ded7}.f-stat-icon{width:42px;height:42px;border-radius:12px;background:#eaf7f2;color:#0f745f;display:grid;place-items:center;font-size:18px;transition:transform .25s ease,background .25s ease;flex:0 0 auto}.f-stat:hover .f-stat-icon{transform:scale(1.06) rotate(-2deg);background:#dff4ed}.f-stat-body{min-width:0}.f-stat-body span{display:block;color:var(--f-muted);font-size:11px}.f-stat-body strong{display:block;font-size:clamp(21px,2.1vw,25px);letter-spacing:-.04em;margin-top:3px;overflow-wrap:anywhere}.f-stat-body small{color:#18835f;font-size:10px}.f-card{position:relative;overflow:hidden;background:var(--f-panel);border:1px solid var(--f-line);border-radius:16px;box-shadow:var(--f-shadow);transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.f-card:not(.f-modal-card):hover{transform:translateY(-2px);box-shadow:var(--f-shadow-hover);border-color:#cddfd9}.f-card:not(.f-modal-card)::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,rgba(255,255,255,.45),transparent 28%,transparent 72%,rgba(16,109,95,.025));opacity:.75}.f-card.pad{padding:18px}.f-card-head{position:relative;z-index:1;padding:16px 18px;border-bottom:1px solid var(--f-line);display:flex;align-items:center;justify-content:space-between;gap:10px}.f-card-head h3{margin:0;font-size:15px}.f-card-head p{margin:3px 0 0;color:var(--f-muted);font-size:11px}.f-table{width:100%;border-collapse:collapse}.f-table th,.f-table td{padding:13px 15px;border-bottom:1px solid #eaf0ee;text-align:left}.f-table th{font-size:10px;color:#74817e;text-transform:uppercase;letter-spacing:.08em;background:#eaf1ee}.f-table td{font-size:12px}.f-table tbody tr{transition:background .16s ease,transform .16s ease}.f-table tbody tr:hover{transform:translateX(1px)}.f-table tbody tr:hover td{background:#fbfefd}.f-badge{display:inline-flex;align-items:center;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:800;transition:transform .16s ease}.f-badge.green{background:#e6f7ef;color:#0d7a58}.f-badge.blue{background:#e9f2ff;color:#256bc4}.f-badge.amber{background:#fff3dd;color:#9a6a11}.f-badge.red{background:#fdeae7;color:#a5483d}.f-badge.neutral{background:#eef2f0;color:#66736f}.f-badge:hover{transform:translateY(-1px)}.f-toolbar{display:flex;gap:8px;padding:14px;border-bottom:1px solid var(--f-line);flex-wrap:wrap;background:rgba(241,247,245,.68)}.f-input,.f-select,.f-textarea{border:1px solid #bccbc6;background:rgba(218,227,223,.90);border-radius:10px;padding:10px 12px;outline:none;color:var(--f-ink);transition:background .16s ease,border-color .16s ease,box-shadow .16s ease,transform .16s ease}.f-input::placeholder,.f-textarea::placeholder{color:#7a8a87}.f-input:hover,.f-select:hover,.f-textarea:hover{background:#dfe8e4;border-color:#afc2bc}.f-input:focus,.f-select:focus,.f-textarea:focus{background:#f7faf9}.f-input:focus,.f-select:focus,.f-textarea:focus{border-color:#0b766d;box-shadow:0 0 0 3px rgba(11,118,109,.10);transform:translateY(-1px)}.f-input{min-width:250px}.f-panel-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px}.f-form{padding:18px;display:grid;gap:12px}.f-form label{display:grid;gap:6px;font-size:11px;font-weight:700;color:#42504c}.f-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.f-form .full{grid-column:1/-1}.f-empty{padding:50px 20px;text-align:center;color:var(--f-muted)}.f-empty strong{display:block;color:var(--f-ink);margin-bottom:5px}.f-kpi-row{display:grid;grid-template-columns:1.6fr 1fr;gap:12px}.f-chart{height:260px;padding:16px}.f-chart svg{width:100%;height:100%}.f-list{display:grid;gap:0}.f-list-item{padding:12px 16px;border-bottom:1px solid #eef3f1;display:flex;justify-content:space-between;gap:10px}.f-list-item:last-child{border-bottom:0}.f-muted{color:var(--f-muted)}.f-number{font-weight:800}.f-progress{height:8px;background:#edf3ef;border-radius:99px;overflow:hidden}.f-progress>span{display:block;height:100%;background:var(--f-teal);border-radius:99px}.f-footer{padding:24px 0;color:#81908b;font-size:10px;text-align:right}.f-search-results{position:absolute;left:0;right:0;top:48px;background:#f5f8f7;border:1px solid var(--f-line);border-radius:12px;box-shadow:0 18px 36px rgba(16,55,47,.12);padding:6px;z-index:50}.f-search-results button{display:grid;grid-template-columns:24px 1fr auto;gap:8px;align-items:center;width:100%;border:0;background:transparent;padding:10px;border-radius:8px;text-align:left;cursor:pointer}.f-search-results button:hover{background:#f3faf7}.f-search-results button small{color:var(--f-muted)}.f-search-empty{padding:12px;color:var(--f-muted);font-size:12px}.f-notification-dot{position:absolute;top:-4px;right:-4px;min-width:16px;height:16px;padding:0 4px;border-radius:99px;background:#e86c5e;color:white;font-size:9px;font-weight:800;display:grid;place-items:center}.f-notification-panel{position:absolute;right:28px;top:54px;width:min(360px,calc(100vw - 32px));background:#f5f8f7;border:1px solid var(--f-line);border-radius:14px;box-shadow:0 18px 36px rgba(16,55,47,.12);overflow:hidden;z-index:60}.f-modal-backdrop{position:fixed;inset:0;background:rgba(3,30,27,.44);display:flex;align-items:flex-start;justify-content:center;z-index:1000;padding:clamp(10px,3vh,28px) 12px;overflow:auto;overscroll-behavior:contain;backdrop-filter:blur(6px);animation:f-fade-in .18s ease both}.f-modal-card{width:min(820px,calc(100vw - 24px));max-height:calc(100dvh - 20px);overflow:hidden;display:flex;flex-direction:column;animation:f-modal-in .24s cubic-bezier(.2,.8,.2,1) both;box-shadow:0 28px 80px rgba(12,47,40,.24)}.f-modal-header{position:relative;z-index:2;padding:18px 22px;border-bottom:1px solid var(--f-line);display:flex;align-items:flex-start;justify-content:space-between;gap:16px;background:var(--f-panel);flex:0 0 auto}.f-modal-header-copy{min-width:0}.f-modal-header h3{margin:0;font-size:18px;letter-spacing:-.02em}.f-modal-header p{margin:4px 0 0;color:var(--f-muted);font-size:11px}.f-modal-close{width:34px;height:34px;padding:0;font-size:20px;line-height:1}.f-modal-body{overflow:auto;min-height:0;overscroll-behavior:contain}.f-commercial-form{padding:20px 22px 22px;gap:14px}.f-form-section{border:1px solid #cbd8d4;border-radius:13px;padding:14px;background:#f5f8f7}.f-form-section-title{display:flex;align-items:center;gap:8px;margin-bottom:11px;color:#23322e;font-size:12px;font-weight:800}.f-optional{font-size:9px;font-weight:700;color:var(--f-muted);background:#eef3f1;border-radius:999px;padding:3px 7px}.f-field-hint{font-size:10px;font-weight:500;color:var(--f-muted);margin-top:-2px}.f-summary-card{position:relative;overflow:hidden;border:1px solid #bfe1d7;border-radius:14px;background:linear-gradient(180deg,#f5fcf9,#eaf7f2);padding:16px;box-shadow:0 12px 30px rgba(15,109,95,.06)}.f-summary-card::after{content:"";position:absolute;inset:-40% auto auto -10%;width:180px;height:180px;border-radius:50%;background:rgba(55,189,157,.09);filter:blur(2px);animation:f-float 5s ease-in-out infinite;pointer-events:none}.f-summary-head{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}.f-summary-head strong,.f-summary-head span{display:block}.f-summary-head span{font-size:10px;color:var(--f-muted);margin-top:3px}.f-summary-total{font-size:20px;font-weight:900;letter-spacing:-.03em;color:#0b6658;white-space:nowrap}.f-summary-lines{position:relative;z-index:1;border-top:1px solid #dcefe8}.f-summary-lines>div{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #dcefe8;font-size:11px}.f-summary-lines>div.total{padding-top:11px;font-size:13px;border-bottom:0}.f-summary-lines .negative{color:#a5483d}.f-modal-actions{display:flex;justify-content:flex-end;gap:8px;padding:12px 0 0;position:sticky;bottom:0;background:linear-gradient(180deg,rgba(248,250,249,0),#f8faf9 28%);padding-bottom:2px}.f-input[type=number]{-moz-appearance:textfield}.f-input[type=number]::-webkit-outer-spin-button,.f-input[type=number]::-webkit-inner-spin-button{margin:0;-webkit-appearance:none}.f-pagehead{animation:f-rise .45s ease both}.f-pagehead h1{background:linear-gradient(90deg,#14232a,#0f6d5f 72%,#2e7dd7);-webkit-background-clip:text;background-clip:text;color:transparent}.f-info-tip{display:inline-flex;align-items:center}.f-info-tip-trigger{width:21px;height:21px;border:1px solid #bdd5ce;background:#f5fbf8;color:#0c695b;border-radius:50%;display:grid;place-items:center;padding:0;font-weight:900;font-size:11px;line-height:1;cursor:pointer;transition:transform .16s ease,background .16s ease,border-color .16s ease,box-shadow .16s ease}.f-info-tip-trigger:hover,.f-info-tip-trigger:focus-visible{background:#e4f4ef;border-color:#9fc9bd;box-shadow:0 0 0 3px rgba(15,109,95,.08);outline:none;transform:translateY(-1px)}.f-info-tip-popover{position:fixed;z-index:100000;width:min(340px,calc(100vw - 32px));padding:12px 13px;background:#102e2a;color:#effaf6;border:1px solid rgba(255,255,255,.12);border-radius:12px;box-shadow:0 22px 54px rgba(16,55,47,.28),0 4px 16px rgba(16,55,47,.18);opacity:0;visibility:hidden;transform:translateY(-4px);pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s ease}.f-info-tip-popover:before{content:'';position:absolute;left:24px;top:-5px;width:10px;height:10px;background:#102e2a;border-left:1px solid rgba(255,255,255,.12);border-top:1px solid rgba(255,255,255,.12);transform:rotate(45deg)}.f-info-tip-popover.is-top:before{top:auto;bottom:-5px;border-left:0;border-top:0;border-right:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12)}.f-info-tip-popover strong,.f-info-tip-popover span{display:block}.f-info-tip-popover strong{font-size:10px;color:#9fe4d0;text-transform:uppercase;letter-spacing:.08em}.f-info-tip-popover span{margin-top:5px;font-size:11px;line-height:1.58;color:#effaf6}.f-info-tip-popover.is-open{opacity:1;visibility:visible;transform:none;pointer-events:auto}.f-detail-page{max-width:1400px}.f-breadcrumb{display:flex;align-items:center;gap:8px;margin:-8px 0 14px;color:var(--f-muted);font-size:11px}.f-breadcrumb a{color:var(--f-teal);font-weight:700}.f-inline-alert{animation:f-rise .24s ease both}.f-invoice-card-head{align-items:flex-start}.f-inline-alert{margin:12px 14px 0;padding:10px 12px;border:1px solid var(--f-line);border-radius:10px;font-size:11px;font-weight:700}.f-inline-alert.success{background:#eaf8f2;color:#0d725a;border-color:#d4eee5}.f-inline-alert.error{background:#fff0ee;color:#a0443c;border-color:#f2d5d0}.f-inline-alert.info{background:#eef5ff;color:#2f66a3;border-color:#dce8f8}.f-invoice-status{display:grid;gap:5px;min-width:95px}.f-status-sub{font-size:10px;color:var(--f-muted);font-weight:600;white-space:nowrap}.f-invoice-action-group{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.f-btn-compact{padding:8px 10px;white-space:nowrap}@keyframes f-page-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}@keyframes f-rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes f-fade-in{from{opacity:0}to{opacity:1}}@keyframes f-modal-in{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:none}}@keyframes f-float{0%,100%{transform:translate(0,0)}50%{transform:translate(10px,8px)}}
@media(max-width:1180px){.f-top{background:linear-gradient(180deg,rgba(6,74,69,.18) 0%,rgba(225,235,232,.44) 82%,rgba(243,247,245,.22) 100%)}.f-side{--f-side-w:clamp(200px,20vw,220px)}.f-content{padding:20px}.f-grid-4{grid-template-columns:repeat(2,minmax(0,1fr))}.f-panel-grid,.f-kpi-row{grid-template-columns:1fr}.f-pagehead{gap:12px}.f-top-right .f-date{display:none}.f-search-wrap{width:min(440px,55vw);flex-basis:440px}.f-modal-card{width:min(780px,calc(100vw - 24px))}}
@media(max-width:900px){.f-pagehead{flex-direction:column}.f-page-actions{width:100%;justify-content:flex-start}.f-search-wrap{width:min(100%,460px);flex-basis:auto}.f-top-right .f-title{display:none}.f-form-grid{grid-template-columns:1fr}.f-form .full{grid-column:auto}.f-modal-backdrop{padding:8px}.f-modal-card{max-height:calc(100dvh - 16px);border-radius:14px}.f-modal-header{padding:15px 16px}.f-commercial-form{padding:16px}.f-summary-head{flex-direction:column}.f-summary-total{font-size:18px}}
@media(max-width:780px){.f-side{display:none}.f-top{height:62px;padding:0 14px;background:linear-gradient(180deg,rgba(6,74,69,.16),rgba(225,235,232,.38) 86%,rgba(243,247,245,.18))}.f-top-search{flex:1}.f-top-right .f-date,.f-top-right .f-title{display:none}.f-content{padding:18px;animation:none}.f-grid-3,.f-grid-4{grid-template-columns:1fr}.f-pagehead h1{font-size:28px;background:none;color:var(--f-ink)}.f-panel-grid{grid-template-columns:1fr}.f-table{min-width:760px}.f-detail-grid{grid-template-columns:1fr}.f-detail-grid>div:nth-last-child(-n+2){border-bottom:1px solid #eef3f1}.f-detail-grid>div:last-child{border-bottom:0}.f-detail-grid .full{grid-column:auto}.f-info-tip-popover{left:16px !important;right:16px;top:auto !important;bottom:16px;width:auto;transform:translateY(4px)}.f-info-tip-popover.is-top{bottom:16px}.f-info-tip-popover:before{display:none}.f-search-results{left:0;right:0}.f-notification-panel{right:0}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}.f-card:not(.f-modal-card):hover,.f-stat:hover,.f-btn:hover:not(:disabled),.f-table tbody tr:hover,.f-nav-item:hover,.f-info-tip-trigger:hover{transform:none!important}}

/* v8 palette refinement: smoke-white surfaces, stronger green-tinted page background */
.f-panel-grid > .f-card, .f-kpi-row > .f-card, .f-detail-card, .f-summary-card { background: var(--f-panel); }
.f-card .f-card-head { background: rgba(247,250,249,.58); }
.f-modal-card { background: #f5f8f7; }
.f-modal-header { background: rgba(247,250,249,.94); }
.f-summary-head, .f-summary-row { background: rgba(243,248,246,.68); }

/* v9 top-area gradient integration: extend Finora green higher into the canvas and visually connect the sticky top bar. */
.f-top{box-shadow:0 8px 24px rgba(16,55,47,.045)}
.f-top-search kbd{background:rgba(238,245,242,.92)}

/* v10 visual system: Finora green canvas with a longer top-to-bottom fade and smoke-white surfaces. */
:root{
  --f-bg:#e2e9e6;
  --f-panel:#f3f7f5;
  --f-line:#cfddd8;
}
html{background:var(--f-bg)}
body{
  background:
    linear-gradient(180deg,rgba(6,74,69,.20) 0%,rgba(6,74,69,.19) 18%,rgba(6,74,69,.16) 38%,rgba(6,74,69,.12) 58%,rgba(255,255,255,.08) 73%,rgba(255,255,255,.24) 88%,rgba(255,255,255,.38) 100%),
    linear-gradient(180deg,rgba(6,74,69,.08) 0%,rgba(6,74,69,.03) 58%,rgba(226,233,230,0) 100%),
    var(--f-bg);
  background-attachment:fixed;
}
.f-top{
  background:linear-gradient(180deg,rgba(213,230,225,.62) 0%,rgba(222,235,231,.52) 52%,rgba(231,240,237,.42) 100%);
  border-bottom:1px solid rgba(130,164,155,.34);
  box-shadow:0 8px 28px rgba(6,74,69,.055);
  backdrop-filter:blur(14px) saturate(115%);
}
.f-top-search,.f-icon{
  background:rgba(244,248,246,.72);
  border-color:rgba(155,184,176,.62);
}
.f-top-search kbd{background:rgba(237,245,242,.78)}
.f-card{
  background:var(--f-panel);
  border-color:#cfddd8;
  box-shadow:0 12px 34px rgba(11,57,50,.085);
}
.f-card:not(.f-modal-card)::after{
  background:linear-gradient(120deg,rgba(255,255,255,.30),transparent 30%,transparent 72%,rgba(15,109,95,.035));
  opacity:.65;
}
.f-stat{
  background:linear-gradient(145deg,#f5f8f7 0%,#f1f6f4 68%,#e8f1ee 100%);
  border-color:#cfddd8;
  box-shadow:0 12px 30px rgba(11,57,50,.08);
}
.f-stat:hover,.f-card:not(.f-modal-card):hover{
  border-color:#bcd3cc;
  box-shadow:0 18px 42px rgba(11,57,50,.13);
}
.f-form-section{background:rgba(239,245,242,.82);border-color:#c8d8d2}
.f-toolbar{background:rgba(234,242,239,.68)}
.f-table th{background:rgba(228,238,234,.78)}
.f-table tbody tr:hover td{background:rgba(248,252,250,.72)}
.f-input,.f-select,.f-textarea{
  background:rgba(220,229,225,.86);
  border-color:#b8cac4;
}
.f-input:hover,.f-select:hover,.f-textarea:hover{background:rgba(212,223,218,.94)}
.f-input:focus,.f-select:focus,.f-textarea:focus{background:#f4f8f6}
.f-modal-card{background:#f1f6f4}
.f-modal-header{background:rgba(244,248,246,.94)}
